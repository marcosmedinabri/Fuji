# Configuración de Fuji. Este archivo vive en ~/.config/fujibot/env y es PRIVADO:
# nunca lo subas a ningún repositorio.

# Cerebro de Fuji: claude (tu Claude Code, recomendado) | anthropic | groq | ollama
CARA_BACKEND=claude

# Carpeta desde la que trabaja Claude Code (su memoria va ligada a ella)
#CLAUDE_CWD=~
# Esfuerzo de razonamiento: low (rápido) | medium | high
#CLAUDE_EFFORT=low

# Comandos de Bash que Fuji puede ejecutar sin preguntarte, separados por comas
#FUJI_TRUSTED_COMMANDS=

# Solo si usas otro backend:
#ANTHROPIC_API_KEY=
#GROQ_API_KEY=
#OLLAMA_MODEL=llama3.2

# Voz
#CARA_TTS=espeak
#ESPEAK_VOICE=es
#WHISPER_MODEL=small
#WHISPER_DEVICE=cpu
